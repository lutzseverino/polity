{
  "name": "@polity/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#components/ui/hooks/*": "./src/components/ui/hooks/*.ts"
  },
  "exports": {
    "./styles.css": "./src/styles.css",
    "./alert": "./src/components/app/alert.ts",
    "./avatar": "./src/components/app/avatar.ts",
    "./badge": "./src/components/app/badge.ts",
    "./button": "./src/components/app/button.ts",
    "./card": "./src/components/app/card.ts",
    "./dialog": "./src/components/app/dialog.ts",
    "./drawer": "./src/components/app/drawer.ts",
    "./dropdown-menu": "./src/components/app/dropdown-menu.ts",
    "./empty": "./src/components/app/empty.ts",
    "./field": "./src/components/app/field.ts",
    "./input": "./src/components/app/input.ts",
    "./input-group": "./src/components/app/input-group.ts",
    "./label": "./src/components/app/label.ts",
    "./native-select": "./src/components/app/native-select.ts",
    "./popover": "./src/components/app/popover.ts",
    "./progress": "./src/components/app/progress.ts",
    "./select": "./src/components/app/select.ts",
    "./separator": "./src/components/app/separator.ts",
    "./sheet": "./src/components/app/sheet.ts",
    "./skeleton": "./src/components/app/skeleton.ts",
    "./tabs": "./src/components/app/tabs.ts",
    "./textarea": "./src/components/app/textarea.ts",
    "./toggle": "./src/components/app/toggle.ts",
    "./toggle-group": "./src/components/app/toggle-group.ts",
    "./tooltip": "./src/components/app/tooltip.ts",
    "./use-mobile": "./src/components/app/use-mobile.ts"
  },
  "scripts": {
    "check:architecture": "depcruise --config dependency-cruiser.cjs src",
    "format": "prettier --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --check .",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "ui:add": "node scripts/registry.mjs add",
    "ui:check": "node scripts/registry.mjs check",
    "ui:update": "node scripts/registry.mjs update",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm ui:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.0",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.1",
    "recharts": "3.8.0",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "4.13.0",
    "typescript": "^7.0.2"
  }
}
