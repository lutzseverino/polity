{
  "name": "@polity/design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "polity-design": "./bin/polity-design.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./brand.css": "./src/themes/brand.css",
    "./product.css": "./src/themes/product.css",
    "./tokens": "./src/tokens.ts",
    "./tokens.json": "./src/tokens.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "check:architecture": "depcruise --config dependency-cruiser.cjs src bin",
    "check:theme": "node bin/polity-design.mjs generate brand-theme --check",
    "format": "prettier --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --check .",
    "generate:theme": "node bin/polity-design.mjs generate brand-theme",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm check:theme"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
