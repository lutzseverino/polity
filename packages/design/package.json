{
  "name": "@polity/design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "polity-design": "./bin/polity-design.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./brand.css": "./src/themes/brand.css",
    "./product.css": "./src/themes/product.css",
    "./tokens": "./src/tokens.ts",
    "./tokens.json": "./src/tokens.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "check:architecture": "depcruise --config dependency-cruiser.cjs src bin",
    "check:theme": "node bin/polity-design.mjs generate brand-theme --check",
    "generate:theme": "node bin/polity-design.mjs generate brand-theme",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
